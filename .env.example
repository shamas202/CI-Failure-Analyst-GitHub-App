# GitHub App Configuration
# Get these from your GitHub App settings page (https://github.com/settings/apps)

# Your GitHub App's ID (a number like 123456)
GITHUB_APP_ID=

# Your GitHub App's private key (the .pem file content)
# IMPORTANT: Must be on ONE line with \n for newlines, like:
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_PRIVATE_KEY=

# Your GitHub App's OAuth client ID (like Iv1.abcdef123)
GITHUB_APP_CLIENT_ID=

# Your GitHub App's OAuth client secret
GITHUB_APP_CLIENT_SECRET=

# Webhook Secret
# Must match exactly what you set in GitHub App webhook settings
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Anthropic API Key
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Your Vercel deployment URL (for reference)
VERCEL_URL=
